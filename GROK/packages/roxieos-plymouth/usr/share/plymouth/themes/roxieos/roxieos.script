roxieos_bg_color = 0.11, 0.16, 0.12;
roxieos_fg_color = 0.94, 0.95, 0.96;

Window.SetBackgroundColor(roxieos_bg_color);
Window.SetTextColor(roxieos_fg_color);

fun message_callback (text) {
    Window.SetTextColor(roxieos_fg_color);
    Window.PaintText("ROXIEOS", 0.5, 0.4, 2.0);
    Window.SetTextColor(1.0, 0.0, 0.0);
    Window.PaintText("You just got Roxanne'd", 0.5, 0.6, 1.0);
}

Plymouth.SetUpdateStatusFunction(message_callback);