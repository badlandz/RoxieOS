#!/usr/bin/env bash
# baux-bot — REAL version — actually talks to Grok-4 and Ollama
set -euo pipefail

PAYLOAD="${1:-$(cat)}"
LOG="/tmp/baux-bot.log"
TS=$(date '+%H:%M')

MODEL=$(echo "$PAYLOAD" | jq -r '.model')
QUESTION=$(echo "$PAYLOAD" | jq -r '.question')
CONTEXT=$(echo "$PAYLOAD" | jq -r '.context')

echo "$TS [$MODEL] >>>" >> "$LOG"
echo "$QUESTION" >> "$LOG"
echo "$TS [$MODEL] thinking…" >> "$LOG"

case "$MODEL" in
  "grok-4")
    RESPONSE=$(grok-cli --model grok-4 "$QUESTION\n\nContext:\n$CONTEXT" 2>/dev/null || echo "ERROR: grok-cli failed (no credits or bad key?)")
    ;;
  "deepseek-coder"|"deepseek-coder:110b")
    # Force-pull the exact model you want
    ollama pull deepseek-coder:latest >/dev/null 2>&1 || true
    RESPONSE=$(ollama run deepseek-coder:latest "$QUESTION" 2>/dev/null || echo "ERROR: ollama failed")
    ;;
  *)
    RESPONSE="ERROR: no backend for $MODEL"
    ;;
esac

echo "$TS [$MODEL] <<<" >> "$LOG"
echo "$RESPONSE" >> "$LOG"
echo "────────────────────────────────────" >> "$LOG"
