#!/usr/local/bin/bash
# dev-assist.sh - Development assistant using XAI API for BAUXBSD
# Dec 07 2025

set -euo pipefail

API_KEY="${GROK_API_KEY:-}"
if [[ -z "$API_KEY" ]]; then
    echo "ERROR: GROK_API_KEY environment variable not set"
    echo "Set it with: export GROK_API_KEY='your-api-key'"
    exit 1
fi

# Collect all arguments as the prompt
if [[ $# -eq 0 ]]; then
    echo "Usage: dev-assist <development question or task>"
    exit 1
fi

PROMPT="$*"

# System prompt for development assistance
SYSTEM_PROMPT="You are a development assistant for BAUXBSD, a FreeBSD-based operating system. Provide helpful, practical advice for coding, debugging, and system administration tasks. Be concise and actionable."

# API call
RESPONSE=$(curl -s -X POST "https://api.x.ai/v1/chat/completions" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $API_KEY" \
    -d "{
        \"model\": \"grok-2-latest\",
        \"messages\": [
            {
                \"role\": \"system\",
                \"content\": \"$SYSTEM_PROMPT\"
            },
            {
                \"role\": \"user\",
                \"content\": \"$PROMPT\"
            }
        ],
        \"max_tokens\": 1024,
        \"temperature\": 0.7
    }")

# Extract the response text
TEXT=$(echo "$RESPONSE" | jq -r '.choices[0].message.content' 2>/dev/null || echo "Error parsing response")

echo "$TEXT"