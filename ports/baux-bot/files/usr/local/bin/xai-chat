#!/usr/local/bin/bash
# xai-chat.sh - XAI API chat client for BAUXBSD
# Dec 07 2025

set -euo pipefail

API_KEY="${GROK_API_KEY:-}"
if [[ -z "$API_KEY" ]]; then
    echo "ERROR: GROK_API_KEY environment variable not set"
    echo "Set it with: export GROK_API_KEY='your-api-key'"
    exit 1
fi

# Collect all arguments as the prompt
if [[ $# -eq 0 ]]; then
    echo "Usage: xai-chat <prompt>"
    exit 1
fi

PROMPT="$*"

# API call
RESPONSE=$(curl -s -X POST "https://api.x.ai/v1/chat/completions" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $API_KEY" \
    -d "{
        \"model\": \"grok-3\",
        \"messages\": [
            {
                \"role\": \"user\",
                \"content\": \"$PROMPT\"
            }
        ],
        \"max_tokens\": 1024,
        \"temperature\": 0.7
    }")

# Check if response is valid JSON and extract text
if echo "$RESPONSE" | jq -e '.choices[0].message.content' >/dev/null 2>&1; then
    TEXT=$(echo "$RESPONSE" | jq -r '.choices[0].message.content')
else
    TEXT="Error: Invalid API response format. Raw response: $RESPONSE"
fi

echo "$TEXT"