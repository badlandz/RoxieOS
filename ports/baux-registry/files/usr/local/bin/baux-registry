#!/usr/local/bin/bash
# baux-registry - Simple JSON file-based session registry

REGISTRY_DIR=${BAUX_REGISTRY_DIR:-/var/db/baux}

init_registry() {
    mkdir -p "$REGISTRY_DIR"
    echo "Registry initialized at $REGISTRY_DIR"
}

register_session() {
    local name="$1" node="$2" pid="$3"
    init_registry
    local now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    echo "{\"name\":\"$name\",\"node\":\"$node\",\"pid\":\"$pid\",\"updated_at\":\"$now\",\"last_seen\":\"$now\",\"status\":\"active\"}" > "$REGISTRY_DIR/session_$name.json"
    echo "Session '$name' registered on node '$node'"
}

list_sessions() {
    echo "Name                  Node                  Status    Last Seen"
    echo "--------------------  --------------------  --------  -------------------"
    for file in "$REGISTRY_DIR"/session_*.json; do
        [[ -f "$file" ]] || continue
        local content=$(cat "$file")
        local name=$(echo "$content" | sed 's/.*"name":"\([^"]*\)".*/\1/')
        local node=$(echo "$content" | sed 's/.*"node":"\([^"]*\)".*/\1/')
        local status=$(echo "$content" | sed 's/.*"status":"\([^"]*\)".*/\1/')
        local last_seen=$(echo "$content" | sed 's/.*"last_seen":"\([^"]*\)".*/\1/')
        printf "%-20s  %-20s  %-8s  %s\n" "$name" "$node" "$status" "$last_seen"
    done
}

find_session() {
    local name="$1"
    [[ -f "$REGISTRY_DIR/session_$name.json" ]] && sed 's/.*"node":"\([^"]*\)".*/\1/' "$REGISTRY_DIR/session_$name.json"
}

register_node() {
    local hostname="$1" ip="$2"
    init_registry
    local now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    echo "{\"hostname\":\"$hostname\",\"ip_address\":\"$ip\",\"last_seen\":\"$now\",\"status\":\"online\"}" > "$REGISTRY_DIR/node_$hostname.json"
}

case "$1" in
    "init") init_registry ;;
    "register") register_session "$2" "$3" "$4" ;;
    "list") list_sessions ;;
    "find") find_session "$2" ;;
    "register-node") register_node "$2" "$3" ;;
    "test") init_registry; echo "Registry ready at $REGISTRY_DIR" ;;
    *) echo "Usage: baux-registry {init|register|list|find|register-node|test}" ;;
esac
