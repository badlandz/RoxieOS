#!/usr/bin/env bash
# baux-session-tui — BAUX Session Selector TUI
# Interactive session management interface
set -euo pipefail

# Colors for TUI
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m' # No Color

# Get available sessions
get_sessions() {
    tmux list-sessions 2>/dev/null | awk -F: '{print $1}' || echo ""
}

# Get remote hosts (BAUX-MESH aware detection)
get_remote_hosts() {
    local hosts=""

    # Method 1: BAUX-MESH via Tailscale (primary method)
    if command -v tailscale >/dev/null 2>&1; then
        # Get all tailscale peers with their info
        local tailscale_output
        tailscale_output=$(tailscale status 2>/dev/null || echo "")

        if [[ -n "$tailscale_output" ]]; then
            # Extract peer hostnames (excluding ourselves)
            local current_hostname
            current_hostname=$(hostname -s)

            # Parse tailscale status for peer names
            local peers
            peers=$(echo "$tailscale_output" | awk '/^[a-zA-Z0-9_-]+\s+[0-9]+\./ {print $1}' | grep -v "^$current_hostname$" || echo "")

            for peer in $peers; do
                # Map peer names to BAUX hostnames
                case "$peer" in
                    "baux01") hosts="${hosts}baux01 " ;;
                    "01x300") hosts="${hosts}baux-133 " ;;  # .133 node
                    "baux-scale") hosts="${hosts}baux-scale " ;;
                    *) hosts="${hosts}$peer " ;;  # Include unknown peers
                esac
            done

            # If we have mesh peers, this is our primary method
            if [[ -n "$hosts" ]]; then
                echo "$hosts" | tr ' ' '\n' | grep -v '^$' | sort | uniq
                return
            fi
        fi
    fi

    # Method 2: Direct network detection (fallback)
    # Check known BAUX hostnames with multiple methods
    for host in baux01 baux02 baux03 baux-scale; do
        # Try multiple connectivity tests
        if ping -c 1 -W 2 "$host" >/dev/null 2>&1 || \
           timeout 2 nc -z "$host" 22 >/dev/null 2>&1 2>/dev/null || \
           timeout 2 ssh -o ConnectTimeout=2 -o StrictHostKeyChecking=no -o PasswordAuthentication=no -o ConnectTimeout=2 "$host" "echo 1" >/dev/null 2>&1; then
            hosts="${hosts}$host "
        fi
    done

    # Method 3: Environment-based detection
    if [[ -n "${BAUX_MESH_NODES:-}" ]]; then
        # Space-separated list of known mesh nodes
        for node in $BAUX_MESH_NODES; do
            if [[ "$hosts" != *"$node"* ]]; then
                hosts="${hosts}$node "
            fi
        done
    fi

    # Method 4: Headscale server detection
    if [[ -n "${BAUX_HEADSCALE_SERVER:-}" ]]; then
        if [[ "$hosts" != *"$BAUX_HEADSCALE_SERVER"* ]]; then
            hosts="${hosts}$BAUX_HEADSCALE_SERVER "
        fi
    fi

    # Return unique, sorted list
    echo "$hosts" | tr ' ' '\n' | grep -v '^$' | sort | uniq || echo ""
}

# Query bauxd for sessions on a remote host
get_remote_sessions() {
    local host="$1"
    local port="${2:-9999}"

    # Try to query bauxd API
    if command -v curl >/dev/null 2>&1; then
        curl -s --max-time 5 "http://$host:$port/sessions" 2>/dev/null || echo "[]"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O - --timeout=5 "http://$host:$port/sessions" 2>/dev/null || echo "[]"
    else
        # Fallback to direct SSH if no HTTP client
        ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o PasswordAuthentication=no "$host" "tmux list-sessions 2>/dev/null | awk -F: '{print \$1}' | jq -R . | jq -s 'map({name: .})'" 2>/dev/null || echo "[]"
    fi
}

# Display header
show_header() {
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${WHITE}                    BAUX SESSION SELECTOR${CYAN}                    ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo
}

# Display local sessions
show_local_sessions() {
    echo -e "${YELLOW}LOCAL SESSIONS:${NC}"
    local sessions=$(get_sessions)
    if [[ -z "$sessions" ]]; then
        echo -e "${RED}  No active sessions${NC}"
        echo
        return
    fi

    local count=1
    echo "$sessions" | while read -r session; do
        if [[ "$session" == "$(tmux display-message -p '#S' 2>/dev/null)" ]]; then
            echo -e "${GREEN}  $count. $session ${WHITE}(current)${NC}"
        else
            echo -e "${WHITE}  $count. $session${NC}"
        fi
        ((count++))
    done
    echo
}

# Display remote hosts
show_remote_hosts() {
    echo -e "${YELLOW}REMOTE BAUX NODES:${NC}"
    local hosts=$(get_remote_hosts)
    if [[ -z "$hosts" ]]; then
        echo -e "${RED}  No remote nodes detected${NC}"
        echo
        return
    fi

    local count=1
    echo "$hosts" | while read -r host; do
        echo -e "${BLUE}  $count. $host${NC}"
        ((count++))
    done
    echo
}

# Main menu
show_menu() {
    echo -e "${MAGENTA}OPTIONS:${NC}"
    echo -e "${WHITE}  l. List all sessions${NC}"
    echo -e "${WHITE}  c. Create new session${NC}"
    echo -e "${WHITE}  r. Connect to remote session${NC}"
    echo -e "${WHITE}  k. Kill session${NC}"
    echo -e "${WHITE}  p. Push current session to mesh${NC}"
    echo -e "${WHITE}  h. Help${NC}"
    echo -e "${WHITE}  q. Quit${NC}"
    echo
}

# Create new session
create_session() {
    echo -n "Enter session name: "
    read -r session_name
    if [[ -z "$session_name" ]]; then
        echo -e "${RED}Session name cannot be empty${NC}"
        return
    fi

    if tmux has-session -t "$session_name" 2>/dev/null; then
        echo -e "${RED}Session '$session_name' already exists${NC}"
        return
    fi

    echo "Creating session '$session_name'..."
    tmux new-session -d -s "$session_name"
    tmux switch-client -t "$session_name"
}

# Kill session
kill_session() {
    local sessions=$(get_sessions)
    if [[ -z "$sessions" ]]; then
        echo -e "${RED}No sessions to kill${NC}"
        return
    fi

    echo "Available sessions:"
    local count=1
    echo "$sessions" | while read -r session; do
        echo "  $count. $session"
        ((count++))
    done

    echo -n "Enter session number to kill: "
    read -r choice

    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -lt 1 ]] || [[ "$choice" -gt "$count" ]]; then
        echo -e "${RED}Invalid choice${NC}"
        return
    fi

    local session=$(echo "$sessions" | sed -n "${choice}p")
    echo -n "Really kill session '$session'? (y/N): "
    read -r confirm

    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        tmux kill-session -t "$session"
        echo -e "${GREEN}Session '$session' killed${NC}"
    fi
}

# Connect to remote session
connect_remote() {
    local hosts=$(get_remote_hosts)
    if [[ -z "$hosts" ]]; then
        echo -e "${RED}No remote BAUX-MESH nodes detected${NC}"
        echo -e "${YELLOW}Make sure Tailscale is running and connected to BAUX-MESH${NC}"
        return
    fi

    echo "Available BAUX-MESH nodes:"
    local count=1
    local host_array=()
    while read -r host; do
        host_array+=("$host")
        echo "  $count. $host"
        ((count++))
    done <<< "$hosts"

    echo -n "Select remote node: "
    read -r host_choice

    if ! [[ "$host_choice" =~ ^[0-9]+$ ]] || [[ "$host_choice" -lt 1 ]] || [[ "$host_choice" -ge "$count" ]]; then
        echo -e "${RED}Invalid choice${NC}"
        return
    fi

    local host="${host_array[$((host_choice - 1))]}"
    if [[ -z "$host" ]]; then
        echo -e "${RED}Invalid host selection${NC}"
        return
    fi

    # Get available sessions on remote host via bauxd API
    echo "Checking sessions on $host via bauxd..."
    local remote_sessions_json
    remote_sessions_json=$(get_remote_sessions "$host")

    # Parse JSON and display sessions
    if command -v jq >/dev/null 2>&1 && [[ "$remote_sessions_json" != "[]" ]]; then
        echo "Available sessions on $host:"
        local session_count=1
        local session_array=()
        echo "$remote_sessions_json" | jq -r '.[] | "\(.name) (\(.windows) windows)"' | while read -r session_info; do
            local session_name=$(echo "$session_info" | awk '{print $1}')
            session_array+=("$session_name")
            echo "  $session_count. $session_info"
            ((session_count++))
        done

        echo -n "Select session number (or press Enter for default): "
        read -r session_choice

        if [[ -z "$session_choice" ]]; then
            session_name="baux-$(hostname)"
        elif [[ "$session_choice" =~ ^[0-9]+$ ]] && [[ "$session_choice" -ge 1 ]] && [[ "$session_choice" -lt "$session_count" ]]; then
            session_name="${session_array[$((session_choice - 1))]}"
        else
            echo -e "${RED}Invalid session choice${NC}"
            return
        fi
    else
        # Fallback if no sessions found or jq not available
        echo -n "Enter session name on $host (default: baux-$(hostname)): "
        read -r session_name
        session_name="${session_name:-baux-$(hostname)}"
    fi

    echo -e "${GREEN}Connecting to session '$session_name' on $host via BAUX-MESH...${NC}"

    # Try bauxd API first, fallback to baux pull
    if curl -s --max-time 5 "http://$host:9999/sessions/$session_name" >/dev/null 2>&1; then
        echo "Using bauxd API for connection..."
        # For now, still use baux pull as the API isn't fully implemented
        exec baux pull "$host" "$session_name"
    else
        echo "Falling back to direct connection..."
        exec baux pull "$host" "$session_name"
    fi
}

# Push current session
push_session() {
    if [[ -z "${TMUX:-}" ]]; then
        echo -e "${RED}Not in a tmux session${NC}"
        return
    fi

    echo "Pushing current session to BAUX-MESH..."
    exec baux push
}

# Main loop
main() {
    while true; do
        clear
        show_header
        show_local_sessions
        show_remote_hosts
        show_menu

        echo -n "Choose an option: "
        read -r choice

        case "$choice" in
            l|L)
                # List all sessions (already shown)
                echo "Press Enter to continue..."
                read -r
                ;;
            c|C)
                create_session
                echo "Press Enter to continue..."
                read -r
                ;;
            r|R)
                connect_remote
                ;;
            k|K)
                kill_session
                echo "Press Enter to continue..."
                read -r
                ;;
            p|P)
                push_session
                ;;
            h|H)
                echo "BAUX Session Selector Help:"
                echo "  l - List all local and remote sessions"
                echo "  c - Create a new local session"
                echo "  r - Connect to a remote BAUX session"
                echo "  k - Kill a local session"
                echo "  p - Push current session to BAUX-MESH"
                echo "  q - Quit"
                echo
                echo "Press Enter to continue..."
                read -r
                ;;
            q|Q)
                echo "Goodbye!"
                exit 0
                ;;
            *)
                # Try to interpret as session number
                local sessions=$(get_sessions)
                if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 ]]; then
                    local session=$(echo "$sessions" | sed -n "${choice}p")
                    if [[ -n "$session" ]]; then
                        echo "Switching to session '$session'..."
                        tmux switch-client -t "$session"
                        exit 0
                    fi
                fi

                echo -e "${RED}Invalid option. Press 'h' for help.${NC}"
                echo "Press Enter to continue..."
                read -r
                ;;
        esac
    done
}

# Run main function
main
<parameter name="filePath">ports/baux/files/usr/local/share/baux/scripts/baux-session-tui