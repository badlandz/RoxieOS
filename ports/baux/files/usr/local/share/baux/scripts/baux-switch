#!/usr/bin/env bash
# baux-switch — Switch to a remote BAUX session
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: baux switch <remote-session> [remote-host]"
    echo "Examples:"
    echo "  baux switch baux01-3          # Switch to session on current host"
    echo "  baux switch ProjectX baux02   # Switch to ProjectX on baux02"
    exit 1
fi

SESSION="$1"
REMOTE="${2:-$(hostname)}"

if [[ "$REMOTE" == "$(hostname)" ]]; then
    # Local session
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        tmux switch-client -t "$SESSION"
    else
        echo "Session $SESSION not found locally. Creating..."
        tmux new-session -d -s "$SESSION"
        tmux switch-client -t "$SESSION"
    fi
else
    # Remote session - pull it
    echo "Switching to remote session $SESSION on $REMOTE..."
    exec baux pull "$REMOTE" "$SESSION"
fi