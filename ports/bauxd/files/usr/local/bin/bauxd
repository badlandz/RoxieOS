#!/bin/sh
# bauxd - BAUX daemon service

if [ "$1" = "test" ]; then
    echo "bauxd test: working"
    exit 0
fi

if [ "$1" = "status" ]; then
    echo "bauxd status: ready"
    exit 0
fi

if [ "$1" = "start" ]; then
    echo "bauxd start: not implemented"
    exit 0
fi

if [ "$1" = "stop" ]; then
    echo "bauxd stop: not implemented"
    exit 0
fi

echo "Usage: bauxd {start|stop|status|test}"
exit 1</content>
<parameter name="filePath">ports/bauxd/files/usr/local/bin/bauxd