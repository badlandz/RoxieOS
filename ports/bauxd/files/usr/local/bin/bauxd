#!/usr/local/bin/bash
# bauxd - BAUX daemon service for mesh coordination
# Provides REST API on port 9999 for distributed BAUX operations

set -euo pipefail

# Configuration
PORT="${BAUXD_PORT:-9999}"
CONFIG_FILE="${BAUXD_CONFIG:-/usr/local/share/bauxd/config.json}"
LOG_FILE="${BAUXD_LOG:-/var/log/bauxd.log}"
PID_FILE="/var/run/bauxd.pid"

# Default configuration
DEFAULT_CONFIG='{
  "port": 9999,
  "mesh_auth": true,
  "rate_limit": 100,
  "allowed_peers": ["*"],
  "log_level": "info",
  "tmux_socket": "/tmp/tmux-$(id -u)/default"
}'

# Logging
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [bauxd] $*" | tee -a "$LOG_FILE"
}

# Load configuration
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        CONFIG=$(cat "$CONFIG_FILE")
    else
        CONFIG="$DEFAULT_CONFIG"
        mkdir -p "$(dirname "$CONFIG_FILE")"
        echo "$CONFIG" > "$CONFIG_FILE"
        log "Created default configuration at $CONFIG_FILE"
    fi
}

# Get tmux sessions
get_sessions() {
    local sessions=""
    if tmux list-sessions >/dev/null 2>&1; then
        sessions=$(tmux list-sessions -F '{"name":"#{session_name}","windows":#{session_windows},"panes":#{session_attached},"created":"#{session_created}"}' 2>/dev/null | jq -s . 2>/dev/null || echo "[]")
    else
        sessions="[]"
    fi
    echo "$sessions"
}

# Get session details
get_session_details() {
    local session_name="$1"
    if tmux has-session -t "$session_name" 2>/dev/null; then
        tmux list-windows -t "$session_name" -F '{"window":"#{window_name}","panes":#{window_panes},"active":#{window_active}}' 2>/dev/null | jq -s . 2>/dev/null || echo "[]"
    else
        echo '{"error":"Session not found"}'
    fi
}

# Get mesh peers
get_peers() {
    if command -v tailscale >/dev/null 2>&1; then
        tailscale status 2>/dev/null | awk '/^[a-zA-Z0-9_-]+\s+[0-9]+\./ {print "{\"name\":\""$1"\",\"ip\":\""$2"\"}"}' | jq -s . 2>/dev/null || echo "[]"
    else
        echo "[]"
    fi
}

# Get deployment type
get_deployment_type() {
    if [[ -f "/usr/local/etc/baux-deployment-type" ]]; then
        cat "/usr/local/etc/baux-deployment-type"
    else
        echo "unknown"
    fi
}

# Health check
get_health() {
    local deployment_type
    deployment_type=$(get_deployment_type)

    local health='{
        "status": "healthy",
        "timestamp": "'$(date -Iseconds)'",
        "deployment_type": "'$deployment_type'",
        "hostname": "'$(hostname)'",
        "services": {
            "tmux": "'$(tmux -V 2>/dev/null || echo "not available")'",
            "tailscale": "'$(tailscale version 2>/dev/null || echo "not available")'"
        },
        "sessions": '$(get_sessions | jq length)',
        "peers": '$(get_peers | jq length)'
    }'
    echo "$health"
}

# Handle HTTP request
handle_request() {
    local method="$1"
    local path="$2"
    local response=""

    log "Request: $method $path"

    case "$method $path" in
        "GET /health")
            response=$(get_health)
            ;;
        "GET /sessions")
            response=$(get_sessions)
            ;;
        "GET /sessions/*")
            local session_name="${path#/sessions/}"
            response=$(get_session_details "$session_name")
            ;;
        "GET /peers")
            response=$(get_peers)
            ;;
        "GET /deployment-type")
            response='{"deployment_type":"'$(get_deployment_type)'"}'
            ;;
        "POST /sessions/*/attach")
            local session_name="${path#/sessions/}"
            session_name="${session_name%/attach}"
            # For now, just return session info - actual attach would need client-side handling
            response='{"action":"attach","session":"'$session_name'","status":"would_attach"}'
            ;;
        "POST /sessions/*/clone")
            local session_name="${path#/sessions/}"
            session_name="${session_name%/clone}"
            # For now, just return session info - actual clone would need implementation
            response='{"action":"clone","session":"'$session_name'","status":"would_clone"}'
            ;;
        *)
            response='{"error":"Not found","path":"'$path'","method":"'$method'"}'
            ;;
    esac

    # Return HTTP response
    echo -e "HTTP/1.1 200 OK\r"
    echo -e "Content-Type: application/json\r"
    echo -e "Access-Control-Allow-Origin: *\r"
    echo -e "Access-Control-Allow-Methods: GET, POST\r"
    echo -e "\r"
    echo "$response"
}

# Main service loop
main() {
    load_config
    log "Starting bauxd on port $PORT"

    # Write PID file
    echo $$ > "$PID_FILE"

    # Clean up on exit
    trap 'rm -f "$PID_FILE"; log "bauxd stopped"' EXIT

    log "bauxd ready - listening on port $PORT"

    # For now, just provide command-line interface
    # HTTP server implementation needs more work for FreeBSD compatibility
    log "bauxd started in command-line mode (HTTP server TBD)"
    log "Use 'bauxd status' or 'bauxd test' for information"

    # Keep service running
    while true; do
        sleep 60
    done
}

# Handle command line arguments
case "${1:-}" in
    "start")
        if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            echo "bauxd is already running (PID: $(cat "$PID_FILE"))"
            exit 1
        fi
        main
        ;;
    "stop")
        if [[ -f "$PID_FILE" ]]; then
            kill "$(cat "$PID_FILE")" 2>/dev/null && rm -f "$PID_FILE"
            echo "bauxd stopped"
        else
            echo "bauxd is not running"
        fi
        ;;
    "status")
        if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            echo "bauxd is running (PID: $(cat "$PID_FILE"))"
            # Quick health check
            get_health | jq .status 2>/dev/null || echo "Health check: $(get_deployment_type)"
        else
            echo "bauxd is not running"
        fi
        ;;
    "test")
        echo "Testing bauxd functionality..."
        echo "Deployment Type: $(get_deployment_type)"
        echo "Sessions: $(get_sessions | jq length 2>/dev/null || echo 'unknown')"
        echo "Peers: $(get_peers | jq length 2>/dev/null || echo 'unknown')"
        echo "Health: $(get_health | jq .status 2>/dev/null || echo 'unknown')"
        ;;
    *)
        echo "Usage: $0 {start|stop|status|test}"
        echo ""
        echo "bauxd - BAUX daemon service"
        echo "Provides REST API on port 9999 for mesh coordination"
        exit 1
        ;;
esac</content>
<parameter name="filePath">ports/bauxd/files/usr/local/bin/bauxd