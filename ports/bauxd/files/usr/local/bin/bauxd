#!/bin/bash
# bauxd - BAUX daemon service

# Configuration
PORT=${BAUXD_PORT:-9999}

# Get tmux sessions as JSON
get_sessions_json() {
    tmux list-sessions 2>/dev/null | while read -r line; do
        name=$(echo "$line" | cut -d: -f1)
        rest=$(echo "$line" | cut -d: -f2-)
        windows=$(echo "$rest" | grep -o '[0-9]\+ windows' | grep -o '[0-9]\+' || echo "0")
        created=$(echo "$rest" | sed 's/.*(created \(.*\))/\1/' || echo "unknown")
        echo "{\"name\":\"$name\",\"windows\":$windows,\"created\":\"$created\"}"
    done | tr '\n' ',\ | sed 's/,$//' | sed 's/^/[/;s/$/]/' || echo "[]"
}

# HTTP server using netcat
start_http_server() {
    echo "bauxd HTTP server starting on port $PORT..."

    # Create a temporary script for netcat to execute
    local temp_script=$(mktemp)
    cat > "$temp_script" << 'SCRIPT_EOF'
#!/bin/bash
# Read the HTTP request
read -r request_line
read -r -t 0.1 header_line 2>/dev/null || true

# Parse request
method=$(echo "$request_line" | cut -d' ' -f1)
path=$(echo "$request_line" | cut -d' ' -f2)

# Send response based on path
case "$method" in
    "OPTIONS")
        echo -e "HTTP/1.1 200 OK\r"
        echo -e "Access-Control-Allow-Origin: *\r"
        echo -e "Access-Control-Allow-Methods: GET, OPTIONS\r"
        echo -e "Access-Control-Allow-Headers: *\r"
        echo -e "Content-Length: 0\r"
        echo -e "\r"
        ;;
    "GET")
        case "$path" in
            "/health")
                body='{"status":"healthy","service":"bauxd","uptime":"unknown"}'
                echo -e "HTTP/1.1 200 OK\r"
                echo -e "Content-Type: application/json\r"
                echo -e "Access-Control-Allow-Origin: *\r"
                echo -e "Content-Length: ${#body}\r"
                echo -e "\r"
                echo "$body"
                ;;
            "/sessions")
                # Get tmux sessions as JSON
                sessions=$(tmux list-sessions 2>/dev/null | while read -r line; do
                    name=$(echo "$line" | cut -d: -f1)
                    rest=$(echo "$line" | cut -d: -f2-)
                    windows=$(echo "$rest" | grep -o '[0-9]\+ windows' | grep -o '[0-9]\+' || echo "0")
                    created=$(echo "$rest" | sed 's/.*(created \(.*\))/\1/' || echo "unknown")
                    echo "{\"name\":\"$name\",\"windows\":$windows,\"created\":\"$created\"}"
                done | tr '\n' ',\ | sed 's/,$//' | sed 's/^/[/;s/$/]/' || echo "[]")

                echo -e "HTTP/1.1 200 OK\r"
                echo -e "Content-Type: application/json\r"
                echo -e "Access-Control-Allow-Origin: *\r"
                echo -e "Content-Length: ${#sessions}\r"
                echo -e "\r"
                echo "$sessions"
                ;;
            "/")
                body='{"service":"bauxd","version":"1.0","endpoints":["/health","/sessions"]}'
                echo -e "HTTP/1.1 200 OK\r"
                echo -e "Content-Type: application/json\r"
                echo -e "Access-Control-Allow-Origin: *\r"
                echo -e "Content-Length: ${#body}\r"
                echo -e "\r"
                echo "$body"
                ;;
            *)
                body='{"error":"endpoint not found"}'
                echo -e "HTTP/1.1 404 Not Found\r"
                echo -e "Content-Type: application/json\r"
                echo -e "Access-Control-Allow-Origin: *\r"
                echo -e "Content-Length: ${#body}\r"
                echo -e "\r"
                echo "$body"
                ;;
        esac
        ;;
    *)
        body='{"error":"method not allowed"}'
        echo -e "HTTP/1.1 405 Method Not Allowed\r"
        echo -e "Content-Type: application/json\r"
        echo -e "Access-Control-Allow-Origin: *\r"
        echo -e "Content-Length: ${#body}\r"
        echo -e "\r"
        echo "$body"
        ;;
esac
SCRIPT_EOF

    chmod +x "$temp_script"

    # Use netcat to listen for connections
    while true; do
        echo "HTTP server listening on port $PORT..." >&2
        nc -l -p "$PORT" -e "$temp_script" 2>/dev/null
    done

    # Cleanup
    rm -f "$temp_script"
}

# CLI commands
case "$1" in
    "test")
        echo "bauxd test: working"
        ;;
    "status")
        echo "bauxd status: ready (port $PORT)"
        ;;
    "start")
        start_http_server
        ;;
    "stop")
        echo "bauxd stop: send SIGTERM to running process"
        ;;
    "sessions")
        get_sessions_json
        ;;
    *)
        echo "Usage: bauxd {start|stop|status|test|sessions}"
        exit 1
        ;;
esac
