#!/usr/local/bin/bash
# bauxd - BAUX daemon service

# Configuration
PORT=${BAUXD_PORT:-9999}

# Get tmux sessions as JSON (simplified)
get_sessions_json() {
    echo "[]"
}

# Minimal HTTP server for testing
start_http_server() {
    echo "bauxd HTTP server starting on port $PORT..."

    # For now, just respond with a simple health check
    # This is a placeholder - will be improved
    echo '{"status":"healthy","service":"bauxd","version":"1.0"}'
}

# CLI commands
case "$1" in
    "test")
        echo "bauxd test: working"
        ;;
    "status")
        echo "bauxd status: ready (port $PORT)"
        ;;
    "start")
        start_http_server
        ;;
    "stop")
        echo "bauxd stop: send SIGTERM to running process"
        ;;
    "sessions")
        get_sessions_json
        ;;
    *)
        echo "Usage: bauxd {start|stop|status|test,sessions}"
        exit 1
        ;;
esac
